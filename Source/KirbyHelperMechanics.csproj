<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <AssemblyName>KirbyHelperMechanics</AssemblyName>
        <RootNamespace>Celeste.Mod.KirbyHelperMechanics</RootNamespace>
        <LangVersion>latest</LangVersion>
        <CelestePrefix Condition="'$(CelestePrefix)' == '' And Exists('../../../Celeste.dll')">../../..</CelestePrefix>
        <CelestePrefix Condition="'$(CelestePrefix)' == ''">lib-stripped</CelestePrefix>
    </PropertyGroup>

    <ItemDefinitionGroup>
        <PackageReference PrivateAssets="all" ExcludeAssets="runtime" />
        <Reference Private="false" />
    </ItemDefinitionGroup>

    <ItemGroup>
        <PackageReference Include="MonoMod.RuntimeDetour" Version="25.3.6" PrivateAssets="all" ExcludeAssets="runtime" />
        <PackageReference Include="CelesteMod.Publicizer" Version="1.1.2" CelesteAssembly="$(CelestePrefix)/Celeste.dll" />
        <Reference Include="$(CelestePrefix)/MMHOOK_Celeste.dll" Private="false" />
        <Reference Include="$(CelestePrefix)/FNA.dll" Private="false" />
    </ItemGroup>

    <!-- Compile-time-only references to optional third-party helper mods, for
         soft compatibility features gated behind Everest.Loader.DependencyLoaded
         at runtime (same "lib-stripped" pattern Picoline uses for
         ExtendedVariantMode; see Source/Interop/). None of these are shipped:
         Reference Private="false" (set by the ItemDefinitionGroup above) keeps
         them out of bin/, and none are declared as hard Dependencies in
         everest.yaml, only OptionalDependencies, so Kirby Helper Mechanics
         still runs standalone with none of them installed. -->
    <ItemGroup>
        <Reference Include="lib-stripped/ExtendedVariantMode.dll" />
        <Reference Include="lib-stripped/MaxHelpingHand.dll" />
        <Reference Include="lib-stripped/FrostTempleHelper.dll" />
        <Reference Include="lib-stripped/GravityHelper.dll" />
        <Reference Include="lib-stripped/EeveeHelper.dll" />
        <Reference Include="lib-stripped/FactoryHelper.dll" />
        <Reference Include="lib-stripped/JackalHelper.dll" />
    </ItemGroup>

    <!-- Everest loads from bin/KirbyHelperMechanics.dll per everest.yaml, but the
         SDK build only outputs to Source/bin/<config>/net8.0/. Without this copy
         step the mod folder's bin/ never gets created, and Everest reports "mod
         assembly failed to load" because the DLL simply isn't there. -->
    <Target Name="CopyFiles" AfterTargets="Build" Inputs="$(OutputPath)/$(AssemblyName).dll;$(OutputPath)/$(AssemblyName).pdb" Outputs="../bin/$(AssemblyName).dll;../bin/$(AssemblyName).pdb">
        <Copy SourceFiles="$(OutputPath)/$(AssemblyName).dll" DestinationFolder="../bin" />
        <Copy SourceFiles="$(OutputPath)/$(AssemblyName).pdb" DestinationFolder="../bin" />
    </Target>

</Project>
